# ============================================
# ShipEdge Automation - Environment Configuration Example
# Copy this file to .env and update with your actual values
# ============================================

# Base URL for ShipEdge application
BASE_URL=https://qaXX.shipedge.com

# Test ID Attribute used in the application
TEST_ID_ATTRIBUTE=data-testid

# Timezone setting for consistent test behavior
TIMEZONE=America/New_York

# ============================================
# ShipEdge Test User Credentials
# ============================================
TEST_USER_EMAIL=your_email_here
TEST_USER_PASSWORD=your_password_here

# ============================================
# Xenvio Configuration
# ============================================
XENVIO_URL=https://xXX.shipedge.com/users/sign_in
XENVIO_EMAIL=your_xenvio_email@example.com
XENVIO_PASSWORD=your_xenvio_password
XENVIO_API_TOKEN=your_api_token_here
APP_XENVIO=Local
WAREHOUSE_XENVIO=qaXX
ID_SHIP=automatizacion
ORDERS_TO_CREATE=1
APP_URL=https://your_warehouse_url_here

# Used for specific shipment tests
SHORTCUTS_SHIPMENT_NUMBER=SXXX_XXXXXXXX

# ============================================
# Carrier Configuration (EasyPost/Xenvio)
# ============================================
CARRIER_EZ_ACCOUNT=ca_your_account_id_here
CARRIER_API_KEY=EZTK_your_api_key_here

# ============================================
# Playwright Reporting & Evidence
# ============================================
# Set to true to record videos and traces for all tests (success and failure)
CAPTURE_TRACE=false

# ============================================
# Return Label Configuration
# ============================================
# Carrier and Ship Code for return label tests (may differ per environment)
RETURN_LABEL_CARRIER=usps_qa20
RETURN_LABEL_SHIP_CODE=EUSEM

# ============================================
# Carrier Restriction Test (Multi-Box / ezUSPS)
# ============================================
# Optional: override which ship code triggers the restriction dialog.
# If not set, the test will try the built-in list of known restricted codes.
# Example restricted codes: EUSRPBB, EUSRPBA, EUSFLBS, EUSFLBM, EUSFLBL
RESTRICTION_SHIP_CODE=EUSRPBB