# ============================================
# ShipEdge Automation - Environment Configuration Example
# Copy this file to .env and update with your actual values
# ============================================

# Base URL for ShipEdge application
BASE_URL=https://qaXX.shipedge.com

# Test ID Attribute used in the application
TEST_ID_ATTRIBUTE=data-testid

# Timezone setting for consistent test behavior
TIMEZONE=America/New_York

# Reporting environment name
ENV_NAME=QA

# ============================================
# ShipEdge Test User Credentials
# ============================================
TEST_USER_EMAIL=your_email_here
TEST_USER_PASSWORD=your_password_here

# ============================================
# Xenvio Configuration (required by the v2 fixture)
# ============================================
XENVIO_URL=https://xXX.shipedge.com/users/sign_in
XENVIO_EMAIL=your_xenvio_email@example.com
XENVIO_PASSWORD=your_xenvio_password
XENVIO_API_TOKEN=your_api_token_here
# Ship code for orders created through API v3 (e.g. the void test). It must exist only once
# among the warehouse's carriers (the API takes the first match) and use a TEST carrier account.
API_ORDER_SHIP_CODE=EFEXG
APP_XENVIO=Local
WAREHOUSE_XENVIO=qaXX
ID_SHIP=automatizacion
ORDERS_TO_CREATE=1
APP_URL=https://your_warehouse_url_here

# Used for specific shipment tests
SHORTCUTS_SHIPMENT_NUMBER=SXXX_XXXXXXXX

# ============================================
# Carrier Configuration (EasyPost/Xenvio)
# ============================================
CARRIER_EZ_ACCOUNT=ca_your_account_id_here
CARRIER_API_KEY=EZTK_your_api_key_here

# ============================================
# Playwright Reporting & Evidence
# ============================================
# Set to true to record videos and traces for all tests (success and failure)
CAPTURE_TRACE=false

# ============================================
# Return Label Configuration
# ============================================
# Carrier and Ship Code for return label tests (may differ per environment)
RETURN_LABEL_CARRIER=usps_qa20
RETURN_LABEL_SHIP_CODE=EUSEM

# ============================================
# Carrier Restriction Test (Multi-Box / ezUSPS)
# ============================================
# Optional: override which ship code triggers the restriction dialog.
# If not set, the test will try the built-in list of known restricted codes.
# Example restricted codes: EUSRPBB, EUSRPBA, EUSFLBS, EUSFLBM, EUSFLBL
RESTRICTION_SHIP_CODE=EUSRPBB

# ============================================
# Carrier Matrix (npm run carriers:discover / carriers:matrix — docs/19-carrier-matrix.md)
# ============================================
# rates = each ship method must get a rate (nothing is bought) · label = buy the label and void it
CARRIER_MATRIX_MODE=rates
# Optional: probe only these ship codes instead of the discovered file
# CARRIER_MATRIX_SHIP_CODES=EFEXG,EUSEM
# Optional: matrix file (default data/carrier-matrix/<WAREHOUSE_XENVIO>.json)
# CARRIER_MATRIX_FILE=data/carrier-matrix/qa20.json
# Label mode skips production-like carrier accounts unless this is 1
CARRIER_MATRIX_ALLOW_PRODUCTION=0

# ============================================
# Legacy New Order Configuration
# ============================================
# Warehouse option value in the Order header form
LEGACY_WAREHOUSE_ID=141
# Option value for the Custom Shipping Method select (changes per environment)
LEGACY_SHIP_METHOD_ID=7948
# Prefix for the order number (timestamp is appended automatically to avoid duplicates)
LEGACY_ORDER_NUMBER=PruebaCarrier
# Prefix for the shipment number (timestamp is appended automatically)
LEGACY_SHIPMENT_NUMBER=ShipCarrierPrueba
